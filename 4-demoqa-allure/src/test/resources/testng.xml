<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Кроссбраузерный прогон: Chrome и Edge параллельно (parallel=tests).
     Браузеры запускаются headless — окна не появляются;
     переопределение: mvn test -Dheadless=false -->
<suite name="DemoQA Allure Cross-Browser" parallel="tests" thread-count="2">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="tests.TextBoxTest"/>
            <class name="tests.CheckBoxTest"/>
            <class name="tests.RadioButtonTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.FramesTest"/>
            <class name="tests.ProgressBarTest"/>
            <class name="tests.SelectableTest"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="tests.TextBoxTest"/>
            <class name="tests.CheckBoxTest"/>
            <class name="tests.RadioButtonTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.FramesTest"/>
            <class name="tests.ProgressBarTest"/>
            <class name="tests.SelectableTest"/>
        </classes>
    </test>

</suite>
